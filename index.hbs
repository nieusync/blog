{{!< default}}

{{#is "home"}}
    {{!-- Ghost's own title and description are not used here: they are set for
          search results and feeds, not for this heading. --}}
    {{> hero
        label=(t "nav.blog")
        title=(t "home.title")}}
{{/is}}

<section class="section">
    <div class="container">
        {{#if posts}}
            <div class="post-grid">
                {{#foreach posts}}
                    {{> post-card}}
                {{/foreach}}
            </div>
            {{pagination}}
        {{else}}
            <p class="empty">{{t "empty.posts"}}</p>
        {{/if}}
    </div>
</section>
