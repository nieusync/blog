{{!< default}}

{{#is "home"}}
    {{!-- Copy mirrors the "O que pensamos" section on the site's home page.
          Ghost's own title and description are not used here: they are set for
          search results and feeds, not for this heading. --}}
    {{> hero
        label="O que pensamos"
        title="O que pensamos, e como isso fica na prática."
        subtitle="Artigos e casos de uso das cinco disciplinas: o raciocínio, e o trabalho em que deu."}}
{{/is}}

<section class="section">
    <div class="container">
        {{#if posts}}
            <div class="post-grid">
                {{#foreach posts}}
                    {{> post-card}}
                {{/foreach}}
            </div>
            {{pagination}}
        {{else}}
            <p class="empty">Ainda não há artigos publicados.</p>
        {{/if}}
    </div>
</section>
