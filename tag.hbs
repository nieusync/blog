{{!< default}}

{{#tag}}
    {{> hero label=(t "tag.label") title=name subtitle=description}}
{{/tag}}

<section class="section">
    <div class="container">
        {{#if posts}}
            <div class="post-grid">
                {{#foreach posts}}{{> post-card}}{{/foreach}}
            </div>
            {{pagination}}
        {{else}}
            <p class="empty">{{t "empty.tag_posts"}}</p>
        {{/if}}
    </div>
</section>
