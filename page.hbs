{{!< default}}

{{#post}}
<article class="post">
    {{#if @page.show_title_and_feature_image}}
        <header class="post-header">
            <div class="container post-header-inner">
                <div class="accent-line accent-line-center"></div>
                <h1 class="post-title">{{title}}</h1>
            </div>
        </header>

        {{#if feature_image}}
            <div class="container">
                <figure class="post-image">
                    <img src="{{img_url feature_image size="xl"}}"
                         srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w"
                         sizes="(max-width: 1200px) 100vw, 1120px"
                         alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                    {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
                </figure>
            </div>
        {{/if}}
    {{/if}}

    <div class="container">
        <div class="post-content content">
            {{content}}
        </div>
    </div>
</article>
{{/post}}
