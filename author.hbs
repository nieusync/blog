{{!< default}}

{{#author}}
    {{> hero label=(t "post.author") title=name subtitle=bio}}
{{/author}}

<section class="section">
    <div class="container">
        {{#if posts}}
            <div class="post-grid">
                {{#foreach posts}}{{> post-card}}{{/foreach}}
            </div>
            {{pagination}}
        {{else}}
            <p class="empty">{{t "empty.author_posts"}}</p>
        {{/if}}
    </div>
</section>
