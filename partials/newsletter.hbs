<div class="container">
    {{!-- Ghost's own subscribe form: members.js is injected by ghost_foot and
          handles the POST, the confirmation email and the state classes on
          the form, so the theme still ships no JS of its own. The website
          posts to the same members endpoint from its newsletter block. --}}
    <form class="newsletter" data-members-form="subscribe">
        <div class="newsletter-copy">
            <p class="footer-col-title">{{t "newsletter.eyebrow"}}</p>
            <h2 class="newsletter-title">{{t "newsletter.title"}}</h2>
        </div>
        <div class="newsletter-fields">
            <label class="newsletter-label" for="newsletter-email">{{t "newsletter.email"}}</label>
            <div class="newsletter-row">
                <input id="newsletter-email" type="email" name="email" data-members-email required placeholder="{{t "newsletter.placeholder"}}" autocomplete="email">
                <button type="submit">{{t "newsletter.button"}}</button>
            </div>
            <p class="newsletter-message newsletter-success">{{t "newsletter.success"}}</p>
            <p class="newsletter-message newsletter-error">{{t "newsletter.error"}}</p>
        </div>
    </form>
</div>
