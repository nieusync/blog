<div class="container">
    {{!-- Ghost's own subscribe form: members.js is injected by ghost_foot and
          handles the POST, the confirmation email and the state classes on
          the form, so the theme still ships no JS of its own. The website
          posts to the same members endpoint from its newsletter block. --}}
    <form class="newsletter" data-members-form="subscribe">
        <div class="newsletter-copy">
            <p class="footer-col-title">Newsletter</p>
            <h2 class="newsletter-title">Artigos e casos de uso, no seu email</h2>
        </div>
        <div class="newsletter-fields">
            <label class="newsletter-label" for="newsletter-email">Email</label>
            <div class="newsletter-row">
                <input id="newsletter-email" type="email" name="email" data-members-email required placeholder="o.seu@email.com" autocomplete="email">
                <button type="submit">Subscrever</button>
            </div>
            <p class="newsletter-message newsletter-success">Falta um passo: confirme a subscrição no email que lhe enviámos.</p>
            <p class="newsletter-message newsletter-error">Não foi possível subscrever. Verifique o endereço e tente novamente.</p>
        </div>
    </form>
</div>
