{{!-- Mirrors the .card article tile on the site's blog page --}}
<article class="card post-card {{post_class}}">
    {{#if feature_image}}
        <a class="post-card-image" href="{{url}}" aria-hidden="true" tabindex="-1">
            <img src="{{img_url feature_image size="m"}}"
                 srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w"
                 sizes="(max-width: 768px) 100vw, 400px"
                 alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                 loading="lazy">
        </a>
    {{/if}}

    {{#primary_tag}}
        <div class="post-card-tag"><span class="badge badge-purple">{{name}}</span></div>
    {{/primary_tag}}

    <a href="{{url}}"><h3 class="post-card-title">{{title}}</h3></a>

    {{#if excerpt}}<p class="post-card-excerpt">{{excerpt words="24"}}</p>{{/if}}

    <div class="post-card-meta">
        <div class="post-card-meta-row">
            <span class="post-card-time">{{reading_time}} &middot; {{date format="MMM YYYY"}}</span>
            <a class="post-card-more" href="{{url}}">Ler artigo</a>
        </div>
        {{#primary_author}}<span class="post-card-author">{{name}}</span>{{/primary_author}}
    </div>
</article>
