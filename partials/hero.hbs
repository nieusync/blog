{{!-- Gradient hero, mirrors the site's section-label / accent-line / title stack --}}
<section class="hero">
    <div class="container hero-inner">
        {{#if label}}<span class="section-label section-label-white">{{label}}</span>{{/if}}
        <div class="accent-line accent-line-white accent-line-center"></div>
        <h1 class="hero-title">{{title}}</h1>
        {{#if subtitle}}<p class="hero-subtitle">{{subtitle}}</p>{{/if}}
    </div>
</section>
