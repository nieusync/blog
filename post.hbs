{{!< default}}

{{#post}}
<article class="post">
    <header class="post-header">
        <div class="container post-header-inner">
            {{#primary_tag}}<span class="badge badge-light">{{name}}</span>{{/primary_tag}}
            <h1 class="post-title">{{title}}</h1>
            {{#if custom_excerpt}}<p class="post-lead">{{custom_excerpt}}</p>{{/if}}
            <div class="post-meta">
                {{#primary_author}}<span class="post-meta-author">{{name}}</span>{{/primary_author}}
                <span class="post-meta-dot">&middot;</span>
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
                <span class="post-meta-dot">&middot;</span>
                <span>{{reading_time}}</span>
            </div>
        </div>
    </header>

    {{#if feature_image}}
        <div class="container">
            <figure class="post-image">
                <img src="{{img_url feature_image size="xl"}}"
                     srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w"
                     sizes="(max-width: 1200px) 100vw, 1120px"
                     alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
        </div>
    {{/if}}

    <div class="container">
        <div class="post-content content">
            {{content}}
        </div>

        {{#if tags}}
            <div class="post-tags">
                {{#foreach tags}}<a class="badge badge-outline" href="{{url}}">{{name}}</a>{{/foreach}}
            </div>
        {{/if}}

        {{#primary_author}}
            <div class="card author-card">
                {{#if profile_image}}<img class="author-avatar" src="{{img_url profile_image size="s"}}" alt="{{name}}" loading="lazy">{{/if}}
                <div>
                    <span class="section-label">Autor</span>
                    <h3 class="author-name">{{name}}</h3>
                    {{#if bio}}<p class="author-bio">{{bio}}</p>{{/if}}
                </div>
            </div>
        {{/primary_author}}
    </div>
</article>

{{#if @site.members_enabled}}
    <section class="section section-tight">
        <div class="container container-narrow">{{> newsletter}}</div>
    </section>
{{/if}}

{{#if primary_tag}}
{{#get "posts" filter="id:-{{id}}+tag:{{primary_tag.slug}}" limit="2" as |related|}}
    {{#if related}}
        <section class="section section-tight related">
            <div class="container">
                <span class="section-label">Continuar a ler</span>
                <div class="accent-line"></div>
                <div class="post-grid">
                    {{#foreach related}}{{> post-card}}{{/foreach}}
                </div>
            </div>
        </section>
    {{/if}}
{{/get}}
{{/if}}
{{/post}}
